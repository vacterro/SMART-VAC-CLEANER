# Canonical line-ending policy (T-100): all text files live as LF in the
# repository; Windows checkouts may use native CRLF via core.autocrlf.
* text=auto

# SAIPEN byte-bound evidence (digest-verified; never convert line endings) -- T-1508.
.saipen/intake/** -text
.saipen/archive/source/** -text
.saipen/archive/retired/** -text

# Byte-bound evidence keeps its exact bytes, trailing spaces included: the
# release whitespace check must not rewrite or reject operator-supplied text.
.saipen/intake/** whitespace=-trailing-space
.saipen/archive/source/** whitespace=-trailing-space
.saipen/recovery/log-detail/** -text
.saipen/recovery/board-compaction/** -text
.saipen/recovery/log-normalize/** -text
.saipen/recovery/log-foreign-tail/** -text
.saipen/recovery/board-scrub/** -text
